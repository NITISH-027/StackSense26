# StackSense needs no environment variables to run.
# This file exists only because the challenge asks for one when env vars are used.
#
# Optional: port for the web UI (default 8000). Can also be set with --port.
# STACKSENSE_PORT=8000
#
# LLM features: the engine makes no LLM calls in any configuration.
# The only accepted value is "off" (default).
# STACKSENSE_LLM=off
